# Base URL of the NestJS API (must include /api).
# The NestJS API and Next.js both default to port 3000, so the frontend
# in this project runs on port 3001 (see "dev" script in package.json).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Time zone used to display and enter event times.
NEXT_PUBLIC_TIMEZONE=Africa/Addis_Ababa
