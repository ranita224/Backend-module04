@host = http://localhost:3000/api

### 1 Register - expect 201
POST {{host}}/auth/register
Content-Type: application/json

{ "email": "almz@campus.edu.et", "password": "Password123!" }

### 2 Register again - expect 409
POST {{host}}/auth/register
Content-Type: application/json

{ "email": "almz@campus.edu.et", "password": "Password123!" }

### 3 Login - expect 200 + accessToken + refreshToken
POST {{host}}/auth/login
Content-Type: application/json

{ "email": "almz@campus.edu.et", "password": "Password123!" }

### 4 Wrong password - expect 401
POST {{host}}/auth/login
Content-Type: application/json

{ "email": "almz@campus.edu.et", "password": "WrongPass123!" }

### 5 Events still public - expect 200 (no token)
GET {{host}}/events

### 6 Create event WITHOUT token - expect 401
POST {{host}}/events
Content-Type: application/json

{ "title": "Test", "category": "technology", "location": "Main Hall", "eventDate": "2026-12-20", "isPublished": true }

