@host = http://localhost:3000/api

### 1 Register - expect 201
POST {{host}}/auth/register
Content-Type: application/json

{ "email": "almaz@campus.edu.et", "password": "Password123!" }

### 2 Register again - expect 409
POST {{host}}/auth/register
Content-Type: application/json

{ "email": "almaz@campus.edu.et", "password": "Password123!" }

### 3 Login - expect 200 + accessToken + refreshToken
POST {{host}}/auth/login
Content-Type: application/json

{ "email": "almaz@campus.edu.et", "password": "Password123!" }

### 4 Wrong password - expect 401
POST {{host}}/auth/login
Content-Type: application/json

{ "email": "almaz@campus.edu.et", "password": "WrongPass123!" }

### 5 Events still public - expect 200 (no token)
GET {{host}}/events

### 6 Create event WITHOUT token - expect 401
POST {{host}}/events
Content-Type: application/json

{ "title": "Test", "category": "technology", "location": "Main Hall", "eventDate": "2026-12-20", "isPublished": true }

### 7 Create event WITH token - expect 201
POST {{host}}/events
Authorization: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOjEsImVtYWlsIjoiYWxtYXpAY2FtcHVzLmVkdS5ldCIsInJvbGVzIjpbInN0dWRlbnQiXSwiaWF0IjoxNzk1MTc3Nzc0LCJleHAiOjE3OTUxNzg2NzR9.XSvqDiZFtpnnTCHf9POWbi1_xNH1MOYVksx97lmNTNE
Content-Type: application/json

{ "title": "Test", "category": "technology", "location": "Main Hall", "eventDate": "2026-12-20", "isPublished": true }

### 8 Me - expect 200
GET {{host}}/auth/me
Authorization: Bearer PASTE_ACCESS_TOKEN

### 9 Refresh - expect 200, new pair
POST {{host}}/auth/refresh
Content-Type: application/json

{ "refreshToken": "PASTE_REFRESH_TOKEN" }

### 10 Reuse the OLD refresh token - expect 401
POST {{host}}/auth/refresh
Content-Type: application/json

{ "refreshToken": "PASTE_OLD_REFRESH_TOKEN" }

### 11 Logout - expect 200
POST {{host}}/auth/logout
Authorization: Bearer PASTE_ACCESS_TOKEN